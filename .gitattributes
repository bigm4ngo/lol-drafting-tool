# Normalize line endings across platforms.
* text=auto

# Windows scripts must always check out with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Shell scripts must always check out with LF.
*.sh text eol=lf

# Sources and data.
*.py text diff=python
*.json text
*.md text
*.spec text
*.service text

# Binaries.
*.ico binary
*.png binary
